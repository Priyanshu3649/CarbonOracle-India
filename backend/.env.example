NODE_ENV=development
PORT=5010
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=CarbonOracle
JWT_SECRET=your_strong_jwt_secret

DATABASE_URL="mysql://root:your_password@localhost:3306/CarbonOracle"

# ─── Blockchain Configuration (Polygon Amoy Testnet) ───────────────────────
POLYGON_NETWORK=amoy
POLYGON_CHAIN_ID=80002

# Get your RPC URL from https://dashboard.alchemy.com
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Explorer base URL (do not add trailing slash)
BLOCK_EXPLORER_URL=https://amoy.polygonscan.com

# IMPORTANT: This is the private key of the dedicated CarbonOracle backend wallet.
# NEVER share, commit, or log this value.
# NEVER expose it to the frontend.
# Get test POL from: https://faucet.polygon.technology (select Amoy network)
BLOCKCHAIN_PRIVATE_KEY=0x_YOUR_64_CHAR_PRIVATE_KEY_HERE

# Set AFTER deploying the contract:
#   npx hardhat run blockchain/scripts/deploy.ts --network amoy
CARBON_ORACLE_CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS

# Methodology & calculation version strings (embedded on-chain)
METHODOLOGY_VERSION=CarbonOracle-MRV-v1.0
CALCULATION_VERSION=CarbonOracle-Calc-v1.0
