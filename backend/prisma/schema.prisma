// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String?
  role          String   @default("FIELD_AGENT") // ADMIN, SCIENTIST, FIELD_AGENT, PROJECT_OWNER, BUYER
  created_at    DateTime @default(now())

  owned_projects          CarbonProject[]         @relation("ProjectOwner")
  owned_credits           CarbonCredit[]          @relation("CreditOwner")
  retired_credits         CarbonCredit[]          @relation("CreditRetirer")
  sent_transactions       CreditTransaction[]     @relation("TxSender")
  received_transactions   CreditTransaction[]     @relation("TxReceiver")
  retirement_certificates RetirementCertificate[] @relation("CertRetirer")
  marketplace_listings    MarketplaceListing[]    @relation("ListingSeller")
  company_visits          Visit[]                 @relation("CompanyVisits")
  visit_requests          VisitRequest[]          @relation("CompanyVisitRequests")

  @@map("users")
}

model Plot {
  id          String   @id @default(uuid())
  plot_name   String
  description String?
  created_at  DateTime @default(now())

  trees           Tree[]
  upload_batches  UploadBatch[]
  carbon_projects CarbonProject[]
  visits          Visit[]
  visit_requests  VisitRequest[]

  @@map("plots")
}

model Species {
  id                 String   @id @default(uuid())
  common_name        String
  scientific_name    String
  wood_density_g_cm3 Float
  region             String?
  remarks            String?
  created_at         DateTime @default(now())

  trees Tree[]

  @@map("species")
}

model UploadBatch {
  id          String   @id @default(uuid())
  file_name   String
  plot_id     String
  row_count   Int
  uploaded_at DateTime @default(now())
  notes       String?

  plot Plot @relation(fields: [plot_id], references: [id])

  tree_measurements TreeMeasurement[]

  @@map("upload_batches")
}

model Tree {
  id                   String   @id @default(uuid())
  internal_tree_id     String   @unique
  plot_id              String
  species_id           String
  latitude             Float
  longitude            Float
  distance_from_tree_m Float?
  created_at           DateTime @default(now())

  plot         Plot         @relation(fields: [plot_id], references: [id])
  species      Species      @relation(fields: [species_id], references: [id])

  measurements TreeMeasurement[]

  @@unique([latitude, longitude])
  @@map("trees")
}

model TreeMeasurement {
  id                  String   @id @default(uuid())
  tree_id             String

  diameter_cm         Float
  tree_height_m       Float
  wood_density_g_cm3  Float

  // Results
  agb_kg              Float
  agc_kg              Float
  bgb_kg              Float
  bgc_kg              Float
  total_carbon_kg     Float
  co2e_kg             Float

  data_source         String   @default("rover") // "rover" or "manual"
  raw_upload_batch_id String?
  measured_at         DateTime @default(now())

  tree                Tree         @relation(fields: [tree_id], references: [id], onDelete: Cascade)
  upload_batch        UploadBatch? @relation(fields: [raw_upload_batch_id], references: [id])

  @@map("tree_measurements")
}

/// Blockchain integrity record — one per UploadBatch after anchoring on Polygon Amoy.
/// Stores only hashes and metadata. Never stores private keys or raw data.
model BlockchainRecord {
  id                  String    @id @default(uuid())
  report_id           String    @unique              // corresponds to UploadBatch.id
  report_hash         String    // SHA-256 hex (64 chars)
  blockchain_network  String    @default("amoy")
  chain_id            Int       @default(80002)
  contract_address    String    @default("")
  transaction_hash    String?
  block_number        Int?
  explorer_url        String?
  methodology_version String    @default("CarbonOracle-MRV-v1.0")
  calculation_version String    @default("CarbonOracle-Calc-v1.0")
  status              String    @default("PENDING") // PENDING | SUBMITTED | CONFIRMED | FAILED
  failure_reason      String?
  recorded_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("blockchain_records")
}

// ── GWDD Wood Density Reference (17k+ species from Global Wood Density Database)
model WoodDensityReference {
  id             String  @id @default(uuid())
  species        String
  genus          String
  family         String?
  plant_order    String?
  plant_group    String?
  wsg_est        Float
  wsg_est_trunk  Float?
  wsg_est_branch Float?
  wsg_raw        Float?
  nb_samples     Int     @default(1)

  @@index([species])
  @@index([genus])
  @@map("wood_density_reference")
}

// ── Carbon Marketplace Models ────────────────────────────────────────────────

model CarbonProject {
  id               String   @id @default(uuid())
  owner_id         String
  plot_id          String
  title            String
  description      String?
  methodology      String   @default("CarbonOracle-MRV-v1.0")
  status           String   @default("DRAFT") // DRAFT | VERIFIED | LISTED | COMPLETED
  total_credits    Float    @default(0)
  price_per_credit Float    @default(0)
  vintage_year     Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  owner   User           @relation("ProjectOwner", fields: [owner_id], references: [id])
  plot    Plot           @relation(fields: [plot_id], references: [id])
  credits CarbonCredit[]

  @@map("carbon_projects")
}

model CarbonCredit {
  id                String    @id @default(uuid())
  project_id        String
  serial_number     String    @unique
  vintage_year      Int
  quantity_tonnes   Float
  status            String    @default("AVAILABLE") // AVAILABLE | SOLD | RETIRED
  current_owner_id  String?
  retired_by_id     String?
  retired_at        DateTime?
  retirement_reason String?
  created_at        DateTime  @default(now())

  project       CarbonProject         @relation(fields: [project_id], references: [id])
  current_owner User?                 @relation("CreditOwner",   fields: [current_owner_id], references: [id])
  retired_by    User?                 @relation("CreditRetirer", fields: [retired_by_id],    references: [id])
  transactions  CreditTransaction[]
  certificate   RetirementCertificate?
  listings      MarketplaceListing[]

  @@map("carbon_credits")
}

model CreditTransaction {
  id                 String   @id @default(uuid())
  credit_id          String
  from_user_id       String?
  to_user_id         String
  transaction_type   String   // MINT | SALE | TRANSFER | RETIRE
  quantity_tonnes    Float
  price_per_tonne    Float?
  total_price_usd    Float?
  blockchain_tx_hash String?
  status             String   @default("CONFIRMED") // PENDING | CONFIRMED | FAILED
  created_at         DateTime @default(now())

  credit    CarbonCredit @relation(fields: [credit_id],   references: [id])
  from_user User?        @relation("TxSender",   fields: [from_user_id], references: [id])
  to_user   User         @relation("TxReceiver", fields: [to_user_id],   references: [id])

  @@map("credit_transactions")
}

model RetirementCertificate {
  id                 String   @id @default(uuid())
  credit_id          String   @unique
  retired_by_id      String
  beneficiary_name   String
  quantity_tonnes    Float
  retirement_date    DateTime @default(now())
  certificate_number String   @unique
  blockchain_tx_hash String?
  created_at         DateTime @default(now())

  credit     CarbonCredit @relation(fields: [credit_id],      references: [id])
  retired_by User         @relation("CertRetirer", fields: [retired_by_id], references: [id])

  @@map("retirement_certificates")
}

model MarketplaceListing {
  id                 String    @id @default(uuid())
  seller_id          String
  credit_id          String
  quantity_listed    Float
  quantity_available Float
  price_per_credit   Float
  currency           String    @default("USD")
  listing_type       String    @default("FIXED_PRICE")
  status             String    @default("ACTIVE") // ACTIVE | SOLD | CANCELLED | EXPIRED
  expires_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  seller User         @relation("ListingSeller", fields: [seller_id], references: [id])
  credit CarbonCredit @relation(fields: [credit_id], references: [id])

  @@map("marketplace_listings")
}

model Visit {
  id                String    @id @default(uuid())
  company_id        String
  plot_id           String
  visit_type        String    @default("SCHEDULED_MRV") // SCHEDULED_MRV | INTERMEDIATE | AUDIT
  scheduled_date    DateTime
  completed_date    DateTime?
  status            String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  assigned_verifier String?
  notes             String?
  mrv_summary       String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  company User @relation("CompanyVisits", fields: [company_id], references: [id])
  plot    Plot @relation(fields: [plot_id], references: [id])

  @@map("visits")
}

model VisitRequest {
  id             String    @id @default(uuid())
  company_id     String
  plot_id        String
  requested_date DateTime
  reason         String
  description    String?
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewer_notes String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  company User @relation("CompanyVisitRequests", fields: [company_id], references: [id])
  plot    Plot @relation(fields: [plot_id], references: [id])

  @@map("visit_requests")
}

